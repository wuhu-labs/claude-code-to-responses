{
  "include": [
    "reasoning.encrypted_content"
  ],
  "input": [
    {
      "content": "You are a long-running session agent. Keep answers to one sentence.",
      "role": "system"
    },
    {
      "content": [
        {
          "text": "What is the capital of France?",
          "type": "input_text"
        }
      ],
      "role": "user"
    }
  ],
  "model": "gpt-5.4",
  "reasoning": {
    "effort": "high",
    "summary": "auto"
  },
  "store": false,
  "stream": true,
  "tools": [
    {
      "description": "Returns the current weather for a city.",
      "name": "get_weather",
      "parameters": {
        "properties": {
          "city": {
            "description": "City name",
            "type": "string"
          }
        },
        "required": [
          "city"
        ],
        "type": "object"
      },
      "strict": false,
      "type": "function"
    },
    {
      "description": "Folds the conversation so far into a durable summary. Call with a summary of everything above.",
      "name": "compact",
      "parameters": {
        "properties": {
          "summary": {
            "description": "Summary of the conversation so far",
            "type": "string"
          }
        },
        "required": [
          "summary"
        ],
        "type": "object"
      },
      "strict": false,
      "type": "function"
    }
  ]
}
